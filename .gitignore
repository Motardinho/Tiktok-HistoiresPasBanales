# Secrets
.env
.env.*
!.env.example
.claude/settings.local.json

# Python
__pycache__/
*.pyc

# Brouillons et versions de travail
_archives/
identite/archives/
out/**/_montage/
out/**/_versions/
out/**/_ancienne-version/
out/**/_version-*/
out/**/v2-troll/
assets/**/brouillon-*/

# Comparaisons de travail (contiennent la vidéo de référence)
comparaison.mp4

# Sources vidéo et audio téléchargées (Pexels, YouTube) : trop lourdes, à retélécharger
assets/**/*.mp4
assets/**/*.webm
assets/**/*.mkv
assets/**/*.mov
assets/**/*.m4a
assets/**/*.mp3
assets/**/*.wav

# Doublons des finals déjà versionnés à la racine de chaque dossier (même SHA-256, voir validation-utilisateur.json)
out/**/version-validee/*.mp4

# Brouillons de repérage et de contrôle (planches, captures, vignettes)
assets/**/*.jpg
assets/**/*.png
assets/**/*.part
assets/**/*.jsonl
assets/**/tmp/
/*.jpg
/*.png
out/*.jpg
out/*.png
out/*/apercu.png
out/*/youtube-*.jpg

# Sources téléchargées pour les révisions (YouTube, archives) : trop lourdes (jusqu'à 400 Mo), à retélécharger
out/**/sources*/**/*.mp4
out/**/sources*/**/*.webm
out/**/sources*/**/*.mkv
# Intermédiaires de montage (comme _montage/) et exports zip régénérables
out/**/base.mp4
out/*/plans/*.mp4
out/*/voix*.mp3
# Clips et sons de contrôle (lecture à 360 px, raccords) : régénérables par controle.py
out/*/controle/*.mp4
out/*/controle/*.mp3
out/**/*.zip
# Brouillons de session
tmp/

# Vidéos longues : exports de 300 Mo et plus, au-delà de la limite de 100 Mo par fichier de GitHub.
out/long-*/*.mp4

# Dossiers de travail d'une vidéo, régénérables : repérages, grilles de coupes, maquettes, essais de voix et de musique
out/**/reperage/
out/**/coupes/
out/**/maquette/
out/**/essais-voix/
out/**/essais-ton/
out/**/essais-musique/
# Musiques et sons de tiers téléchargés pour les essais ou les mixages : jamais dans le dépôt (public)
out/**/musique/
out/**/audio-v2/
out/**/controle/**/*.mp3
out/**/controle/**/*.wav
out/**/voix*.mp3
# Sources brutes téléchargées à la racine d'un dossier, et fiches yt-dlp volumineuses
out/**/*.webm
out/51-robots-jockeys-v2/afp.mp4
out/**/sources*/**/*.info.json
