[{"start": 0.0, "end": 2.84, "text": " Il hurle de joie. Il n'a pas encore vu le drapeau rouge.", "words": [[0.0, 0.18, " Il"], [0.18, 0.66, " hurle"], [0.66, 0.8, " de"], [0.8, 1.08, " joie."], [1.26, 1.5, " Il"], [1.5, 1.58, " n"], [1.58, 1.64, "'a"], [1.64, 1.78, " pas"], [1.78, 2.0, " encore"], [2.0, 2.2, " vu"], [2.2, 2.32, " le"], [2.32, 2.6, " drapeau"], [2.6, 2.84, " rouge."]]}, {"start": 3.32, "end": 5.78, "text": " 40 jours plus tard, il battra le record du monde.", "words": [[3.32, 3.58, " 40"], [3.58, 3.74, " jours"], [3.74, 3.94, " plus"], [3.94, 4.16, " tard,"], [4.5, 4.54, " il"], [4.54, 4.94, " battra"], [4.94, 5.08, " le"], [5.08, 5.4, " record"], [5.4, 5.54, " du"], [5.54, 5.78, " monde."]]}, {"start": 6.44, "end": 9.02, "text": " Berlin, août 2018, championnat d'Europe.", "words": [[6.44, 6.78, " Berlin,"], [7.08, 7.32, " août"], [7.32, 7.88, " 2018,"], [8.3, 8.7, " championnat"], [8.7, 8.82, " d"], [8.82, 9.02, "'Europe."]]}, {"start": 9.64, "end": 13.16, "text": " Kevin Maier est champion du monde de Décathlon, le grand favori.", "words": [[9.64, 9.78, " Kevin"], [9.78, 10.2, " Maier"], [10.2, 10.48, " est"], [10.48, 10.82, " champion"], [10.82, 11.02, " du"], [11.02, 11.22, " monde"], [11.22, 11.36, " de"], [11.36, 11.8, " Décathlon,"], [12.22, 12.38, " le"], [12.38, 12.68, " grand"], [12.68, 13.16, " favori."]]}, {"start": 13.62, "end": 16.44, "text": " Mais au saut en longueur, il mord ses trois essais.", "words": [[13.62, 14.02, " Mais"], [14.02, 14.38, " au"], [14.38, 14.5, " saut"], [14.5, 14.6, " en"], [14.6, 15.04, " longueur,"], [15.22, 15.44, " il"], [15.44, 15.68, " mord"], [15.68, 15.86, " ses"], [15.86, 16.06, " trois"], [16.06, 16.44, " essais."]]}, {"start": 16.88, "end": 19.5, "text": " Trois fautes, zéro point. Il abandonne.", "words": [[16.88, 17.1, " Trois"], [17.1, 17.44, " fautes,"], [17.82, 18.12, " zéro"], [18.12, 18.34, " point."], [18.68, 19.06, " Il"], [19.06, 19.5, " abandonne."]]}, {"start": 19.74, "end": 23.44, "text": " J'étais prétendant au titre de champion d'Europe et je suis devenu rien du tout.", "words": [[19.74, 19.86, " J"], [19.86, 20.04, "'étais"], [20.04, 20.7, " prétendant"], [20.7, 20.92, " au"], [20.92, 21.18, " titre"], [21.18, 21.36, " de"], [21.36, 21.64, " champion"], [21.64, 21.82, " d"], [21.82, 21.96, "'Europe"], [21.96, 22.16, " et"], [22.16, 22.3, " je"], [22.3, 22.52, " suis"], [22.52, 22.86, " devenu"], [22.86, 23.14, " rien"], [23.14, 23.3, " du"], [23.3, 23.44, " tout."]]}, {"start": 23.68, "end": 27.14, "text": " Deux jours plus tard, il annonce qu'il remet ça, à Talence, près de Bordeaux.", "words": [[23.68, 23.86, " Deux"], [23.86, 23.96, " jours"], [23.96, 24.14, " plus"], [24.14, 24.36, " tard,"], [24.6, 24.72, " il"], [24.72, 24.98, " annonce"], [24.98, 25.08, " qu"], [25.08, 25.14, "'il"], [25.14, 25.42, " remet"], [25.42, 25.56, " ça,"], [26.0, 26.14, " à"], [26.14, 26.5, " Talence,"], [26.64, 26.76, " près"], [26.76, 26.88, " de"], [26.88, 27.14, " Bordeaux."]]}, {"start": 27.14, "end": 32.94, "text": " Et là, sur l'épreuve qu'il a humiliée, il réussit le meilleur saut de sa vie, 7 mètres 80.", "words": [[27.14, 27.74, " Et"], [27.74, 27.92, " là,"], [28.1, 28.44, " sur"], [28.44, 28.52, " l"], [28.52, 28.82, "'épreuve"], [28.82, 28.92, " qu"], [28.92, 29.0, "'il"], [29.0, 29.1, " a"], [29.1, 29.64, " humiliée,"], [29.84, 30.14, " il"], [30.14, 30.54, " réussit"], [30.54, 30.7, " le"], [30.7, 31.06, " meilleur"], [31.06, 31.28, " saut"], [31.28, 31.38, " de"], [31.38, 31.48, " sa"], [31.48, 31.66, " vie,"], [32.02, 32.36, " 7"], [32.36, 32.6, " mètres"], [32.6, 32.94, " 80."]]}, {"start": 33.36, "end": 37.32, "text": " Le lendemain, record personnel au javelot. Il ne reste qu'une course.", "words": [[33.36, 33.74, " Le"], [33.74, 34.14, " lendemain,"], [34.62, 34.86, " record"], [34.86, 35.28, " personnel"], [35.28, 35.44, " au"], [35.44, 35.74, " javelot."], [36.04, 36.36, " Il"], [36.36, 36.46, " ne"], [36.46, 36.68, " reste"], [36.68, 36.88, " qu"], [36.88, 36.98, "'une"], [36.98, 37.32, " course."]]}, {"start": 37.64, "end": 42.54, "text": " Dans les vestiaires, tout le monde était là, il y avait un énorme silence et là je fonds en larmes.", "words": [[37.64, 37.98, " Dans"], [37.98, 38.28, " les"], [38.28, 38.94, " vestiaires,"], [39.28, 39.7, " tout"], [39.7, 39.86, " le"], [39.86, 39.9, " monde"], [39.9, 40.12, " était"], [40.12, 40.28, " là,"], [40.34, 40.38, " il"], [40.38, 40.44, " y"], [40.44, 40.52, " avait"], [40.52, 40.66, " un"], [40.66, 40.98, " énorme"], [40.98, 41.34, " silence"], [41.34, 41.54, " et"], [41.54, 41.66, " là"], [41.66, 41.8, " je"], [41.8, 42.2, " fonds"], [42.2, 42.32, " en"], [42.32, 42.54, " larmes."]]}, {"start": 42.72, "end": 45.58, "text": " Pour le record du monde, il lui faut 4 minutes 49.", "words": [[42.72, 43.04, " Pour"], [43.04, 43.16, " le"], [43.16, 43.4, " record"], [43.4, 43.56, " du"], [43.56, 43.78, " monde,"], [44.14, 44.2, " il"], [44.2, 44.32, " lui"], [44.32, 44.52, " faut"], [44.52, 44.84, " 4"], [44.84, 45.1, " minutes"], [45.1, 45.58, " 49."]]}, {"start": 46.08, "end": 50.54, "text": " On est aux alentours des 4.40 ! Il va le réaliser ! Il va le réaliser !", "words": [[46.08, 46.46, " On"], [46.46, 46.6, " est"], [46.6, 46.72, " aux"], [46.72, 47.04, " alentours"], [47.04, 47.16, " des"], [47.16, 47.34, " 4"], [47.34, 47.66, ".40"], [47.66, 47.92, " !"], [47.92, 48.18, " Il"], [48.18, 48.32, " va"], [48.32, 48.46, " le"], [48.46, 48.94, " réaliser"], [48.94, 49.26, " !"], [49.26, 49.46, " Il"], [49.46, 49.62, " va"], [49.62, 49.76, " le"], [49.76, 50.24, " réaliser"], [50.24, 50.54, " !"]]}, {"start": 50.54, "end": 56.76, "text": " 4.40 ! 4.36 pour Kevin Maier ! C'est incroyable !", "words": [[50.54, 50.96, " 4"], [50.96, 51.52, ".40"], [51.52, 51.76, " !"], [51.76, 52.32, " 4"], [52.32, 53.58, ".36"], [53.58, 53.92, " pour"], [53.92, 54.18, " Kevin"], [54.18, 54.66, " Maier"], [54.66, 55.18, " !"], [55.18, 55.7, " C"], [55.7, 55.82, "'est"], [55.82, 56.42, " incroyable"], [56.42, 56.76, " !"]]}, {"start": 56.76, "end": 60.28, "text": " 4.36 ! On est au-delà des 9.100 points !", "words": [[56.76, 57.44, " 4"], [57.44, 57.88, ".36"], [57.88, 58.2, " !"], [58.2, 58.24, " On"], [58.24, 58.36, " est"], [58.36, 58.5, " au"], [58.5, 58.72, "-delà"], [58.72, 58.9, " des"], [58.9, 59.12, " 9"], [59.12, 59.56, ".100"], [59.56, 59.82, " points"], [59.82, 60.28, " !"]]}, {"start": 60.28, "end": 64.3, "text": " Le record du monde ! C'est sensationnel !", "words": [[60.28, 60.78, " Le"], [60.78, 61.08, " record"], [61.08, 61.54, " du"], [61.54, 61.9, " monde"], [61.9, 62.02, " !"], [62.02, 62.26, " C"], [62.26, 62.74, "'est"], [62.74, 63.64, " sensationnel"], [63.64, 64.3, " !"]]}, {"start": 64.3, "end": 64.74, "text": " Sous-titrage Société Radio-Canada", "words": [[64.3, 64.66, " Sous"], [64.66, 64.74, "-titrage"], [64.74, 64.74, " Société"], [64.74, 64.74, " Radio"], [64.74, 64.74, "-Canada"]]}]