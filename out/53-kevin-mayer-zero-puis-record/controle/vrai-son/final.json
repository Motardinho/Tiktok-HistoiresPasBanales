[{"start": 0.0, "end": 5.2, "text": " Je suis tellement déçu pour moi-même, mais tellement, tellement déçu pour tous ceux qui attendaient quelque chose de moi aujourd'hui.", "words": [[0.0, 0.16, " Je"], [0.16, 0.42, " suis"], [0.42, 1.2, " tellement"], [1.2, 1.6, " déçu"], [1.6, 1.76, " pour"], [1.76, 1.9, " moi"], [1.9, 2.08, "-même,"], [2.2, 2.22, " mais"], [2.22, 2.62, " tellement,"], [2.62, 2.96, " tellement"], [2.96, 3.42, " déçu"], [3.42, 3.6, " pour"], [3.6, 3.74, " tous"], [3.74, 3.9, " ceux"], [3.9, 4.0, " qui"], [4.0, 4.28, " attendaient"], [4.28, 4.42, " quelque"], [4.42, 4.62, " chose"], [4.62, 4.74, " de"], [4.74, 4.86, " moi"], [4.86, 5.06, " aujourd"], [5.06, 5.2, "'hui."]]}, {"start": 5.32, "end": 6.3, "text": " Août 2018.", "words": [[5.32, 5.62, " Août"], [5.62, 6.3, " 2018."]]}, {"start": 6.960000000000003, "end": 10.12, "text": " Kevin Maier vient de faire zéro au championnat d'Europe de Berlin.", "words": [[6.960000000000003, 7.4, " Kevin"], [7.4, 7.8, " Maier"], [7.8, 8.02, " vient"], [8.02, 8.12, " de"], [8.12, 8.34, " faire"], [8.34, 8.8, " zéro"], [8.8, 9.04, " au"], [9.04, 9.42, " championnat"], [9.42, 9.54, " d"], [9.54, 9.66, "'Europe"], [9.66, 9.82, " de"], [9.82, 10.12, " Berlin."]]}, {"start": 10.38, "end": 13.88, "text": " Et pourtant, 40 jours plus tard, il battra le record du monde.", "words": [[10.38, 10.56, " Et"], [10.56, 10.88, " pourtant,"], [11.26, 11.56, " 40"], [11.56, 11.72, " jours"], [11.72, 11.94, " plus"], [11.94, 12.14, " tard,"], [12.36, 12.66, " il"], [12.66, 13.06, " battra"], [13.06, 13.22, " le"], [13.22, 13.5, " record"], [13.5, 13.66, " du"], [13.66, 13.88, " monde."]]}, {"start": 14.5, "end": 18.86, "text": " Champion du monde de Décathlon et grand favori, il hurle de joie après son saut en longueur.", "words": [[14.5, 14.78, " Champion"], [14.78, 14.96, " du"], [14.96, 15.14, " monde"], [15.14, 15.26, " de"], [15.26, 15.68, " Décathlon"], [15.68, 15.86, " et"], [15.86, 16.06, " grand"], [16.06, 16.52, " favori,"], [16.74, 17.0, " il"], [17.0, 17.4, " hurle"], [17.4, 17.56, " de"], [17.56, 17.78, " joie"], [17.78, 17.96, " après"], [17.96, 18.18, " son"], [18.18, 18.36, " saut"], [18.36, 18.46, " en"], [18.46, 18.86, " longueur."]]}, {"start": 19.1, "end": 20.6, "text": " Mais le juge lève un drapeau rouge.", "words": [[19.1, 19.26, " Mais"], [19.26, 19.44, " le"], [19.44, 19.68, " juge"], [19.68, 19.94, " lève"], [19.94, 20.06, " un"], [20.06, 20.3, " drapeau"], [20.3, 20.6, " rouge."]]}, {"start": 20.96, "end": 21.76, "text": " Saut annulé.", "words": [[20.96, 21.24, " Saut"], [21.24, 21.76, " annulé."]]}, {"start": 21.9, "end": 23.06, "text": " Pour la troisième fois.", "words": [[21.9, 22.3, " Pour"], [22.3, 22.44, " la"], [22.44, 22.74, " troisième"], [22.74, 23.06, " fois."]]}, {"start": 23.6, "end": 25.26, "text": " Zéro point, et il abandonne.", "words": [[23.6, 23.92, " Zéro"], [23.92, 24.16, " point,"], [24.32, 24.72, " et"], [24.72, 24.82, " il"], [24.82, 25.26, " abandonne."]]}, {"start": 25.48, "end": 27.18, "text": " C'est pas facile pour moi, je suis désolé.", "words": [[25.48, 25.92, " C"], [25.92, 26.0, "'est"], [26.0, 26.1, " pas"], [26.1, 26.36, " facile"], [26.36, 26.54, " pour"], [26.54, 26.66, " moi,"], [26.76, 26.82, " je"], [26.82, 26.9, " suis"], [26.9, 27.18, " désolé."]]}, {"start": 27.18, "end": 31.08, "text": " J'étais prétendant au titre de champion d'Europe et je suis devenu rien du tout.", "words": [[27.18, 27.5, " J"], [27.5, 27.68, "'étais"], [27.68, 28.38, " prétendant"], [28.38, 28.6, " au"], [28.6, 28.82, " titre"], [28.82, 29.02, " de"], [29.02, 29.28, " champion"], [29.28, 29.46, " d"], [29.46, 29.6, "'Europe"], [29.6, 29.82, " et"], [29.82, 29.96, " je"], [29.96, 30.16, " suis"], [30.16, 30.52, " devenu"], [30.52, 30.78, " rien"], [30.78, 30.96, " du"], [30.96, 31.08, " tout."]]}, {"start": 31.26, "end": 36.42, "text": " En septembre, à Talens, près de Bordeaux, il réussit sur cette même épreuve le meilleur saut de sa vie.", "words": [[31.26, 31.48, " En"], [31.48, 32.0, " septembre,"], [32.24, 32.3, " à"], [32.3, 32.7, " Talens,"], [32.8, 32.96, " près"], [32.96, 33.08, " de"], [33.08, 33.36, " Bordeaux,"], [33.84, 33.94, " il"], [33.94, 34.34, " réussit"], [34.34, 34.48, " sur"], [34.48, 34.68, " cette"], [34.68, 34.88, " même"], [34.88, 35.28, " épreuve"], [35.28, 35.44, " le"], [35.44, 35.8, " meilleur"], [35.8, 36.02, " saut"], [36.02, 36.12, " de"], [36.12, 36.24, " sa"], [36.24, 36.42, " vie."]]}, {"start": 36.72, "end": 37.68, "text": " 7 mètres 80.", "words": [[36.72, 37.06, " 7"], [37.06, 37.3, " mètres"], [37.3, 37.68, " 80."]]}, {"start": 38.0, "end": 40.0, "text": " Puis, un record personnel au javelot.", "words": [[38.0, 38.4, " Puis,"], [38.54, 38.8, " un"], [38.8, 39.04, " record"], [39.04, 39.52, " personnel"], [39.52, 39.68, " au"], [39.68, 40.0, " javelot."]]}, {"start": 40.34, "end": 41.78, "text": " Il ne reste plus qu'une course.", "words": [[40.34, 40.66, " Il"], [40.66, 40.76, " ne"], [40.76, 40.96, " reste"], [40.96, 41.18, " plus"], [41.18, 41.36, " qu"], [41.36, 41.46, "'une"], [41.46, 41.78, " course."]]}, {"start": 41.98, "end": 46.88, "text": " Dans les vestiaires, tout le monde était là, il y avait un énorme silence et là je fonds en larmes.", "words": [[41.98, 42.32, " Dans"], [42.32, 42.68, " les"], [42.68, 43.26, " vestiaires,"], [43.58, 44.02, " tout"], [44.02, 44.18, " le"], [44.18, 44.2, " monde"], [44.2, 44.46, " était"], [44.46, 44.6, " là,"], [44.66, 44.7, " il"], [44.7, 44.78, " y"], [44.78, 44.84, " avait"], [44.84, 44.98, " un"], [44.98, 45.32, " énorme"], [45.32, 45.66, " silence"], [45.66, 45.86, " et"], [45.86, 45.98, " là"], [45.98, 46.14, " je"], [46.14, 46.52, " fonds"], [46.52, 46.64, " en"], [46.64, 46.88, " larmes."]]}, {"start": 47.06, "end": 50.0, "text": " Pour le record du monde, il lui faut 4 minutes 49.", "words": [[47.06, 47.32, " Pour"], [47.32, 47.44, " le"], [47.44, 47.68, " record"], [47.68, 47.82, " du"], [47.82, 48.06, " monde,"], [48.2, 48.56, " il"], [48.56, 48.7, " lui"], [48.7, 48.9, " faut"], [48.9, 49.24, " 4"], [49.24, 49.5, " minutes"], [49.5, 50.0, " 49."]]}, {"start": 50.34, "end": 54.86, "text": " On est aux alentours des 4.40 ! Il va le réaliser ! Il va le réaliser !", "words": [[50.34, 50.72, " On"], [50.72, 50.86, " est"], [50.86, 50.98, " aux"], [50.98, 51.3, " alentours"], [51.3, 51.42, " des"], [51.42, 51.62, " 4"], [51.62, 51.94, ".40"], [51.94, 52.18, " !"], [52.18, 52.44, " Il"], [52.44, 52.58, " va"], [52.58, 52.7, " le"], [52.7, 53.18, " réaliser"], [53.18, 53.46, " !"], [53.46, 53.72, " Il"], [53.72, 53.88, " va"], [53.88, 54.0, " le"], [54.0, 54.5, " réaliser"], [54.5, 54.86, " !"]]}, {"start": 54.86, "end": 59.56, "text": " 4.40 ! Oui ! 4.36 pour Kevin Maier !", "words": [[54.86, 55.26, " 4"], [55.26, 55.54, ".40"], [55.54, 56.06, " !"], [56.06, 56.06, " Oui"], [56.06, 56.72, " !"], [56.72, 57.28, " 4"], [57.28, 57.82, ".36"], [57.82, 58.18, " pour"], [58.18, 58.46, " Kevin"], [58.46, 58.94, " Maier"], [58.94, 59.56, " !"]]}, {"start": 59.56, "end": 64.78, "text": " C'est incroyable ! 4.36 ! On est au-delà des 9.100 points !", "words": [[59.56, 59.96, " C"], [59.96, 60.1, "'est"], [60.1, 60.74, " incroyable"], [60.74, 61.16, " !"], [61.16, 61.66, " 4"], [61.66, 62.24, ".36"], [62.24, 62.46, " !"], [62.46, 62.52, " On"], [62.52, 62.62, " est"], [62.62, 62.74, " au"], [62.74, 63.0, "-delà"], [63.0, 63.16, " des"], [63.16, 63.38, " 9"], [63.38, 63.78, ".100"], [63.78, 64.2, " points"], [64.2, 64.78, " !"]]}, {"start": 64.78, "end": 68.66, "text": " Le record du monde, c'est sensationnel !", "words": [[64.78, 65.14, " Le"], [65.14, 65.42, " record"], [65.42, 65.8, " du"], [65.8, 66.12, " monde,"], [66.4, 66.78, " c"], [66.78, 67.04, "'est"], [67.04, 67.94, " sensationnel"], [67.94, 68.66, " !"]]}, {"start": 68.66, "end": 69.0, "text": " Sous-titrage Société Radio-Canada", "words": [[68.66, 68.88, " Sous"], [68.88, 69.0, "-titrage"], [69.0, 69.0, " Société"], [69.0, 69.