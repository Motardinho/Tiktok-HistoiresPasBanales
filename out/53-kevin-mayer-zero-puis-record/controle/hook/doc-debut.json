[{"start": 1.580000000000001, "end": 5.58, "text": " En longueur, je n'ai pas voulu me brider, je fais un premier essai qui est très très", "words": [[1.580000000000001, 1.9400000000000004, " En"], [1.9400000000000004, 2.3, " longueur,"], [2.4, 2.42, " je"], [2.42, 2.5, " n"], [2.5, 2.5, "'ai"], [2.5, 2.56, " pas"], [2.56, 2.76, " voulu"], [2.76, 2.88, " me"], [2.88, 3.14, " brider,"], [3.44, 3.48, " je"], [3.48, 3.58, " fais"], [3.58, 3.78, " un"], [3.78, 4.06, " premier"], [4.06, 4.38, " essai"], [4.38, 4.52, " qui"], [4.52, 5.22, " est"], [5.22, 5.4, " très"], [5.4, 5.58, " très"]]}, {"start": 5.58, "end": 8.92, "text": " loin en mordant de ça, je fais que de reculer et je mords toujours.", "words": [[5.58, 5.88, " loin"], [5.88, 6.66, " en"], [6.66, 7.02, " mordant"], [7.02, 7.12, " de"], [7.12, 7.26, " ça,"], [7.4, 7.44, " je"], [7.44, 7.54, " fais"], [7.54, 7.66, " que"], [7.66, 7.78, " de"], [7.78, 8.16, " reculer"], [8.16, 8.36, " et"], [8.36, 8.42, " je"], [8.42, 8.58, " mords"], [8.58, 8.92, " toujours."]]}, {"start": 10.16, "end": 14.66, "text": " Écoutez, c'est le sport, je suis tellement déçu pour moi-même, mais tellement, tellement", "words": [[10.16, 10.52, " Écoutez,"], [10.7, 10.76, " c"], [10.76, 10.86, "'est"], [10.86, 11.22, " le"], [11.22, 11.54, " sport,"], [11.74, 11.82, " je"], [11.82, 12.12, " suis"], [12.12, 12.92, " tellement"], [12.92, 13.28, " déçu"], [13.28, 13.44, " pour"], [13.44, 13.6, " moi"], [13.6, 13.78, "-même,"], [13.88, 13.92, " mais"], [13.92, 14.28, " tellement,"], [14.28, 14.66, " tellement"]]}, {"start": 14.66, "end": 16.9, "text": " déçu pour tous ceux qui attendaient quelque chose de moi aujourd'hui.", "words": [[14.66, 15.1, " déçu"], [15.1, 15.3, " pour"], [15.3, 15.44, " tous"], [15.44, 15.58, " ceux"], [15.58, 15.68, " qui"], [15.68, 15.96, " attendaient"], [15.96, 16.14, " quelque"], [16.14, 16.32, " chose"], [16.32, 16.42, " de"], [16.42, 16.56, " moi"], [16.56, 16.74, " aujourd"], [16.74, 16.9, "'hui."]]}, {"start