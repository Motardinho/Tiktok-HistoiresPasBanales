[{"start": 0.0, "end": 4.6, "text": " Il hurle de joie, il croit avoir réussi son saut, mais le juge lève un drapeau rouge.", "words": [[0.0, 0.16, " Il"], [0.16, 0.62, " hurle"], [0.62, 0.76, " de"], [0.76, 1.06, " joie,"], [1.26, 1.48, " il"], [1.48, 1.7, " croit"], [1.7, 1.88, " avoir"], [1.88, 2.22, " réussi"], [2.22, 2.46, " son"], [2.46, 2.7, " saut,"], [2.86, 3.18, " mais"], [3.18, 3.36, " le"], [3.36, 3.62, " juge"], [3.62, 3.96, " lève"], [3.96, 4.08, " un"], [4.08, 4.32, " drapeau"], [4.32, 4.6, " rouge."]]}, {"start": 4.96, "end": 6.62, "text": " Saut annulé, zéro point.", "words": [[4.96, 5.26, " Saut"], [5.26, 5.74, " annulé,"], [6.04, 6.36, " zéro"], [6.36, 6.62, " point."]]}, {"start": 7.12, "end": 7.92, "text": " La douche froide.", "words": [[7.12, 7.28, " La"], [7.28, 7.54, " douche"], [7.54, 7.92, " froide."]]}, {"start": 8.24, "end": 11.9, "text": " Et pourtant, 40 jours plus tard, il battra le record du monde.", "words": [[8.24, 8.72, " Et"], [8.72, 9.04, " pourtant,"], [9.48, 9.74, " 40"], [9.74, 9.9, " jours"], [9.9, 10.12, " plus"], [10.12, 10.34, " tard,"], [10.52, 10.8, " il"], [10.8, 11.16, " battra"], [11.16, 11.3, " le"], [11.3, 11.54, " record"], [11.54, 11.7, " du"], [11.7, 11.9, " monde."]]}, {"start": 12.86, "end": 15.38, "text": " Berlin, août 2018, championnat d'Europe.", "words": [[12.86, 13.28, " Berlin,"], [13.6, 13.78, " août"], [13.78, 14.34, " 2018,"], [14.7, 15.08, " championnat"], [15.08, 15.2, " d"], [15.2, 15.38, "'Europe."]]}, {"start": 15.98, "end": 19.02, "text": " Kevin Mayer est champion du monde de décathlon et grand favori.", "words": [[15.98, 16.16, " Kevin"], [16.16, 16.58, " Mayer"], [16.58, 16.78, " est"], [16.78, 17.12, " champion"], [17.12, 17.3, " du"], [17.3, 17.5, " monde"], [17.5, 17.64, " de"], [17.64, 18.1, " décathlon"], [18.1, 18.34, " et"], [18.34, 18.58, " grand"], [18.58, 19.02, " favori."]]}, {"start": 19.28, "end": 23.68, "text": " Mais au saut en longueur, son pied dépasse la planche à chacun de ses trois essais.", "words": [[19.28, 19.68, " Mais"], [19.68, 19.98, " au"], [19.98, 20.14, " saut"], [20.14, 20.24, " en"], [20.24, 20.66, " longueur,"], [20.82, 21.12, " son"], [21.12, 21.34, " pied"], [21.34, 21.78, " dépasse"], [21.78, 21.92, " la"], [21.92, 22.24, " planche"], [22.24, 22.4, " à"], [22.4, 22.8, " chacun"], [22.8, 22.94, " de"], [22.94, 23.06, " ses"], [23.06, 23.26, " trois"], [23.26, 23.68, " essais."]]}, {"start": 24.16, "end": 25.98, "text": " Trois drapeaux rouges, et il abandonne.", "words": [[24.16, 24.38, " Trois"], [24.38, 24.7, " drapeaux"], [24.7, 25.04, " rouges,"], [25.12, 25.44, " et"], [25.44, 25.56, " il"], [25.56, 25.98, " abandonne."]]}, {"start": 26.12, "end": 29.84, "text": " J'étais prétendant au titre de champion d'Europe et je suis devenu rien du tout.", "words": [[26.12, 26.28, " J"], [26.28, 26.46, "'étais"], [26.46, 27.14, " prétendant"], [27.14, 27.36, " au"], [27.36, 27.6, " titre"], [27.6, 27.78, " de"], [27.78, 28.04, " champion"], [28.04, 28.22, " d"], [28.22, 28.38, "'Europe"], [28.38, 28.58, " et"], [28.58, 28.74, " je"], [28.74, 28.94, " suis"], [28.94, 29.3, " devenu"], [29.3, 29.56, " rien"], [29.56, 29.74, " du"], [29.74, 29.84, " tout."]]}, {"start": 30.0, "end": 33.14, "text": " Deux jours plus tard, il annonce qu'il remet ça à Talens, près de Bordeaux.", "words": [[30.0, 30.28, " Deux"], [30.28, 30.36, " jours"], [30.36, 30.56, " plus"], [30.56, 30.76, " tard,"], [31.06, 31.1, " il"], [31.1, 31.36, " annonce"], [31.36, 31.46, " qu"], [31.46, 31.54, "'il"], [31.54, 31.82, " remet"], [31.82, 31.94, " ça"], [31.94, 32.06, " à"], [32.06, 32.48, " Talens,"], [32.58, 32.72, " près"], [32.72, 32.84, " de"], [32.84, 33.14, " Bordeaux."]]}, {"start": 33.56, "end": 37.48, "text": " Et là, sur l'épreuve qu'il a humiliée, il réussit le meilleur saut de sa vie.", "words": [[33.56, 33.6, " Et"], [33.6, 33.76, " là,"], [34.02, 34.26, " sur"], [34.26, 34.36, " l"], [34.36, 34.64, "'épreuve"], [34.64, 34.74, " qu"], [34.74, 34.8, "'il"], [34.8, 34.9, " a"], [34.9, 35.38, " humiliée,"], [35.72, 35.88, " il"], [35.88, 36.32, " réussit"], [36.32, 36.48, " le"], [36.48, 36.82, " meilleur"], [36.82, 37.06, " saut"], [37.06, 37.18, " de"], [37.18, 37.3, " sa"], [37.3, 37.48, " vie."]]}, {"start": 37.86, "end": 38.64, "text": " 7,80 mètres.", "words": [[37.86, 38.2, " 7"], [38.2, 38.64, ",80"], [38.64, 38.64, " mètres."]]}, {"start": 39.38, "end": 41.54, "text": " Le lendemain, record personnel au Javelot.", "words": [[39.38, 39.58, " Le"], [39.58, 40.0, " lendemain,"], [40.4, 40.64, " record"], [40.64, 41.06, " personnel"], [41.06, 41.22, " au"], [41.22, 41.54, " Javelot."]]}, {"start": 41.74, "end": 43.26, "text": " Et il ne reste plus qu'une course.", "words": [[41.74, 42.0, " Et"], [42.0, 42.12, " il"], [42.12, 42.2, " ne"], [42.2, 42.42, " reste"], [42.42, 42.66, " plus"], [42.66, 42.82, " qu"], [42.82, 42.92, "'une"], [42.92, 43.26, " course."]]}, {"start": 43.44, "end": 48.3, "text": " Dans les vestiaires, tout le monde était là, il y avait un énorme silence et là je fonds en larmes.", "words": [[43.44, 43.72, " Dans"], [43.72, 44.04, " les"], [44.04, 44.72, " vestiaires,"], [45.06, 45.46, " tout"], [45.46, 45.62, " le"], [45.62, 45.64, " monde"], [45.64, 45.9, " était"], [45.9, 46.02, " là,"], [46.1, 46.14, " il"], [46.14, 46.22, " y"], [46.22, 46.28, " avait"], [46.28, 46.42, " un"], [46.42, 46.76, " énorme"], [46.76, 47.1, " silence"], [47.1, 47.3, " et"], [47.3, 47.42, " là"], [47.42, 47.58, " je"], [47.58, 47.96, " fonds"], [47.96, 48.08, " en"], [48.08, 48.3, " larmes."]]}, {"start": 48.44, "end": 51.28, "text": " Pour le record du monde, il lui faut 4 minutes 49.", "words": [[48.44, 48.74, " Pour"], [48.74, 48.88, " le"], [48.88, 49.14, " record"], [49.14, 49.28, " du"], [49.28, 49.5, " monde,"], [49.66, 49.94, " il"], [49.94, 50.06, " lui"], [50.06, 50.26, " faut"], [50.26, 50.58, " 4"], [50.58, 50.82, " minutes"], [50.82, 51.28, " 49."]]}, {"start": 51.66, "end": 56.14, "text": " On est aux alentours des 4.40 ! Il va le réaliser ! Il va le réaliser !", "words": [[51.66, 52.02, " On"], [52.02, 52.14, " est"], [52.14, 52.28, " aux"], [52.28, 52.62, " alentours"], [52.62, 52.74, " des"], [52.74, 52.92, " 4"], [52.92, 53.22, ".40"], [53.22, 53.46, " !"], [53.46, 53.74, " Il"], [53.74, 53.88, " va"], [53.88, 54.02, " le"], [54.02, 54.48, " réaliser"], [54.48, 54.9, " !"], [54.9, 55.0, " Il"], [55.0, 55.2, " va"], [55.2, 55.32, " le"], [55.32, 55.7, " réaliser"], [55.7, 56.14, " !"]]}, {"start": 56.14, "end": 57.96, "text": " 4.40 ! Oui !", "words": [[56.14, 56.52, " 4"], [56.52, 56.98, ".40"], [56.98, 57.18, " !"], [57.18, 57.42, " Oui"], [57.42, 57.96, " !"]]}, {"start": 57.96, "end": 60.78, "text": " 4.36 pour Kevin Maier !", "words": [[57.96, 58.64, " 4"], [58.64, 59.1, ".36"], [59.1, 59.48, " pour"], [59.48, 59.74, " Kevin"], [59.74, 60.54, " Maier"], [60.54, 60.78, " !"]]}, {"start": 60.78, "end": 62.28, "text": " C'est incroyable !", "words": [[60.78, 61.26, " C"], [61.26, 61.4, "'est"], [61.4, 62.02, " incroyable"], [62.02, 62.28, " !"]]}, {"start": 62.28, "end": 62.74, "text": " C'est énorme !", "words": [[62.28, 62.28, " C"], [62.28, 62.44, "'est"], [62.44, 62.74, " énorme"], [62.74, 62.74, " !"]]}, {"start": 62.74, "end": 66.1, "text": " 4.36, on est au-delà des 9100 points !", "words": [[62.74, 62.98, " 4"], [62.98, 63.5, ".36,"], [63.68, 63.82, " on"], [63.82, 63.94, " est"], [63.94, 64.08, " au"], [64.08, 64.28, "-delà"], [64.28, 64.46, " des"], [64.46, 65.08, " 9100"], [65.08, 65.46, " points"], [65.46, 66.1, " !"]]}, {"start": 66.1, "end": 69.94, "text": " Le record du monde, c'est sensationnel !", "words": [[66.1, 66.34, " Le"], [66.34, 66.7, " record"], [66.7, 67.1, " du"], [67.1, 67.46, " monde,"], [67.64, 68.08, " c"], [68.08, 68.36, "'est"], [68.36, 69.22, " sensationnel"], [69.22, 69.94, " !"]]}]