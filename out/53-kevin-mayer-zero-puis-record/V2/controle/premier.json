[{"start": 0.0, "end": 5.18, "text": " Je suis tellement déçu pour moi-même, mais tellement, tellement déçu pour tous ceux qui attendaient quelque chose de moi aujourd'hui.", "words": [[0.0, 0.16, " Je"], [0.16, 0.42, " suis"], [0.42, 1.2, " tellement"], [1.2, 1.58, " déçu"], [1.58, 1.76, " pour"], [1.76, 1.9, " moi"], [1.9, 2.08, "-même,"], [2.2, 2.22, " mais"], [2.22, 2.62, " tellement,"], [2.62, 2.96, " tellement"], [2.96, 3.42, " déçu"], [3.42, 3.6, " pour"], [3.6, 3.76, " tous"], [3.76, 3.9, " ceux"], [3.9, 4.0, " qui"], [4.0, 4.28, " attendaient"], [4.28, 4.44, " quelque"], [4.44, 4.62, " chose"], [4.62, 4.74, " de"], [4.74, 4.86, " moi"], [4.86, 5.06, " aujourd"], [5.06, 5.18, "'hui."]]}, {"start": 5.36, "end": 8.52, "text": " À Berlin, Kevin Maillard croit avoir réussi son saut en longueur.", "words": [[5.36, 5.5, " À"], [5.5, 5.82, " Berlin,"], [6.2, 6.36, " Kevin"], [6.36, 6.74, " Maillard"], [6.74, 7.0, " croit"], [7.0, 7.2, " avoir"], [7.2, 7.56, " réussi"], [7.56, 7.8, " son"], [7.8, 7.98, " saut"], [7.98, 8.1, " en"], [8.1, 8.52, " longueur."]]}, {"start": 8.8, "end": 10.38, "text": " Mais le juge lève son drapeau rouge.", "words": [[8.8, 8.96, " Mais"], [8.96, 9.12, " le"], [9.12, 9.38, " juge"], [9.38, 9.66, " lève"], [9.66, 9.82, " son"], [9.82, 10.1, " drapeau"], [10.1, 10.38, " rouge."]]}, {"start": 10.82, "end": 12.36, "text": " Saut annulé, zéro point.", "words": [[10.82, 11.08, " Saut"], [11.08, 11.56, " annulé,"], [11.94, 12.14, " zéro"], [12.14, 12.36, " point."]]}, {"start": 12.62, "end": 16.28, "text": " J'étais prétendant au titre de champion d'Europe et je suis devenu rien du tout.", "words": [[12.62, 12.74, " J"], [12.74, 12.9, "'étais"], [12.9, 13.56, " prétendant"], [13.56, 13.78, " au"], [13.78, 14.02, " titre"], [14.02, 14.22, " de"], [14.22, 14.48, " champion"], [14.48, 14.66, " d"], [14.66, 14.8, "'Europe"], [14.8, 15.02, " et"], [15.02, 15.16, " je"], [15.16, 15.36, " suis"], [15.36, 15.72, " devenu"], [15.72, 15.98, " rien"], [15.98, 16.14, " du"], [16.14, 16.28, " tout."]]}, {"start": 16.48, "end": 19.12, "text": " Et 40 jours plus tard, à Talens, il fait ça.", "words": [[16.48, 16.62, " Et"], [16.62, 16.9, " 40"], [16.9, 17.06, " jours"], [17.06, 17.26, " plus"], [17.26, 17.52, " tard,"], [17.72, 17.82, " à"], [17.82, 18.26, " Talens,"], [18.56, 18.72, " il"], [18.72, 18.9, " fait"], [18.9, 19.12, " ça."]]}, {"start": 19.34, "end": 24.14, "text": " 4-40, oui ! 4-36 pour Kevin Maillard !", "words": [[19.34, 19.68, " 4"], [19.68, 20.08, "-40,"], [20.32, 20.54, " oui"], [20.54, 20.9, " !"], [20.9, 21.74, " 4"], [21.74, 22.28, "-36"], [22.28, 22.64, " pour"], [22.64, 22.92, " Kevin"], [22.92, 23.68, " Maillard"], [23.68, 24.14, " !"]]}, {"start": 24.14, "end": 29.16, "text": " C'est incroyable ! 4-36, on est au-delà des 9100 points !", "words": [[24.14, 24.42, " C"], [24.42, 24.56, "'est"], [24.56, 25.16, " incroyable"], [25.16, 25.64, " !"], [25.64, 26.1, " 4"], [26.1, 26.68, "-36,"], [26.8, 26.96, " on"], [26.96, 27.08, " est"], [27.08, 27.24, " au"], [27.24, 27.42, "-delà"], [27.42, 27.62, " des"], [27.62, 28.2, " 9100"], [28.2, 28.66, " points"], [28.66, 29.16, " !"]]}, {"start": 29.16, "end": 33.2, "text": " Le record du monde, c'est sensationnel !", "words": [[29.16, 29.48, " Le"], [29.48, 29.98, " record"], [29.98, 30.28, " du"], [30.28, 30.66, " monde,"], [30.76, 31.24, " c"], [31.24, 31.5, "'est"], [31.5, 32.64, " sensationnel"], [32.64, 33.2, " !"]]}]