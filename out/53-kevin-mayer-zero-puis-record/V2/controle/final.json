[{"start": 0.0, "end": 5.18, "text": " Je suis tellement déçu pour moi-même, mais tellement, tellement déçu pour tous ceux qui attendaient quelque chose de moi aujourd'hui.", "words": [[0.0, 0.14, " Je"], [0.14, 0.42, " suis"], [0.42, 1.2, " tellement"], [1.2, 1.58, " déçu"], [1.58, 1.74, " pour"], [1.74, 1.9, " moi"], [1.9, 2.08, "-même,"], [2.18, 2.22, " mais"], [2.22, 2.62, " tellement,"], [2.62, 2.96, " tellement"], [2.96, 3.4, " déçu"], [3.4, 3.6, " pour"], [3.6, 3.74, " tous"], [3.74, 3.88, " ceux"], [3.88, 3.98, " qui"], [3.98, 4.28, " attendaient"], [4.28, 4.44, " quelque"], [4.44, 4.62, " chose"], [4.62, 4.74, " de"], [4.74, 4.86, " moi"], [4.86, 5.04, " aujourd"], [5.04, 5.18, "'hui."]]}, {"start": 5.4, "end": 8.58, "text": " À Berlin, Kevin Maillard croit avoir réussi son saut en longueur.", "words": [[5.4, 5.54, " À"], [5.54, 5.84, " Berlin,"], [6.26, 6.44, " Kevin"], [6.44, 6.8, " Maillard"], [6.8, 7.04, " croit"], [7.04, 7.22, " avoir"], [7.22, 7.62, " réussi"], [7.62, 7.86, " son"], [7.86, 8.04, " saut"], [8.04, 8.16, " en"], [8.16, 8.58, " longueur."]]}, {"start": 8.76, "end": 10.66, "text": " Mais le juge lève son drapeau rouge.", "words": [[8.76, 9.12, " Mais"], [9.12, 9.24, " le"], [9.24, 9.56, " juge"], [9.56, 9.92, " lève"], [9.92, 10.1, " son"], [10.1, 10.36, " drapeau"], [10.36, 10.66, " rouge."]]}, {"start": 11.06, "end": 12.56, "text": " Saut annulé, zéro point.", "words": [[11.06, 11.3, " Saut"], [11.3, 11.8, " annulé,"], [12.08, 12.36, " zéro"], [12.36, 12.56, " point."]]}, {"start": 12.74, "end": 16.44, "text": " J'étais prétendant au titre de champion d'Europe et je suis devenu rien du tout.", "words": [[12.74, 12.88, " J"], [12.88, 13.06, "'étais"], [13.06, 13.72, " prétendant"], [13.72, 13.96, " au"], [13.96, 14.18, " titre"], [14.18, 14.38, " de"], [14.38, 14.62, " champion"], [14.62, 14.82, " d"], [14.82, 14.96, "'Europe"], [14.96, 15.18, " et"], [15.18, 15.32, " je"], [15.32, 15.52, " suis"], [15.52, 15.88, " devenu"], [15.88, 16.16, " rien"], [16.16, 16.32, " du"], [16.32, 16.44, " tout."]]}, {"start": 16.68, "end": 20.02, "text": " Mais le mois suivant, à Talens, il saut à 7,80 mètres.", "words": [[16.68, 16.82, " Mais"], [16.82, 16.92, " le"], [16.92, 17.04, " mois"], [17.04, 17.46, " suivant,"], [17.66, 17.82, " à"], [17.82, 18.22, " Talens,"], [18.44, 18.72, " il"], [18.72, 18.94, " saut"], [18.94, 19.16, " à"], [19.16, 19.44, " 7"], [19.44, 20.0, ",80"], [20.0, 20.02, " mètres."]]}, {"start": 20.58, "end": 25.46, "text": " Dans les vestiaires, tout le monde était là, il y avait un énorme silence et là je fonds en larmes.", "words": [[20.58, 20.9, " Dans"], [20.9, 21.24, " les"], [21.24, 21.86, " vestiaires,"], [22.2, 22.62, " tout"], [22.62, 22.76, " le"], [22.76, 22.8, " monde"], [22.8, 23.04, " était"], [23.04, 23.18, " là,"], [23.26, 23.3, " il"], [23.3, 23.36, " y"], [23.36, 23.44, " avait"], [23.44, 23.58, " un"], [23.58, 23.9, " énorme"], [23.9, 24.28, " silence"], [24.28, 24.46, " et"], [24.46, 24.58, " là"], [24.58, 24.72, " je"], [24.72, 25.12, " fonds"], [25.12, 25.24, " en"], [25.24, 25.46, " larmes."]]}, {"start": 25.46, "end": 30.0, "text": " Pour le record, il lui reste 1 500 mètres à courir en moins de 4 minutes 49.", "words": [[25.46, 25.84, " Pour"], [25.84, 25.96, " le"], [25.96, 26.28, " record,"], [26.52, 26.74, " il"], [26.74, 26.86, " lui"], [26.86, 27.12, " reste"], [27.12, 27.36, " 1"], [27.36, 27.74, " 500"], [27.74, 28.04, " mètres"], [28.04, 28.1, " à"], [28.1, 28.48, " courir"], [28.48, 28.68, " en"], [28.68, 28.86, " moins"], [28.86, 29.0, " de"], [29.0, 29.34, " 4"], [29.34, 29.54, " minutes"], [29.54, 30.0, " 49."]]}, {"start": 30.32, "end": 35.36, "text": " C'est incroyable ! 4 36, on est au-delà des 9 100 points !", "words": [[30.32, 30.6, " C"], [30.6, 30.76, "'est"], [30.76, 31.36, " incroyable"], [31.36, 31.62, " !"], [31.62, 32.36, " 4"], [32.36, 32.8, " 36,"], [33.04, 33.18, " on"], [33.18, 33.26, " est"], [33.26, 33.42, " au"], [33.42, 33.6, "-delà"