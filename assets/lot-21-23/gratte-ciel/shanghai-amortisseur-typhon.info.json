e": -3, "id": "38", "resolution": "1280x720"}, {"url": "https://i.ytimg.com/vi_webp/hIpe86Ha5T0/hq720.webp", "preference": -2, "id": "39"}, {"url": "https://i.ytimg.com/vi/hIpe86Ha5T0/maxresdefault.jpg", "height": 720, "width": 1280, "preference": -1, "id": "40", "resolution": "1280x720"}, {"url": "https://i.ytimg.com/vi_webp/hIpe86Ha5T0/maxresdefault.webp", "height": 1080, "width": 1920, "preference": 0, "id": "41", "resolution": "1920x1080"}], "thumbnail": "https://i.ytimg.com/vi_webp/hIpe86Ha5T0/maxresdefault.webp", "description": "订阅频道，获取更多精彩：https://bit.ly/2GzuCVG\n\n8月10日，台风“利奇马”挟风雨袭来，上海市区街边可见不少被吹落的树枝。与此同时，总高度632米的中国第一高楼上海中心大厦“镇楼宝器”——阻尼器明显开始运作。据了解，上海中心大厦抗风有两大妙招：大厦外形采用柔和轮廓外观和扭转120度的设计，比同样体量矩形建筑的风阻减少24%；此外，大厦125层安装了摆式电涡流调谐质量阻尼器，能有效进行减振控制。“利奇马” 来袭时，阻尼器正在缓慢移动，“对抗”台风。该阻尼器的极限摆幅可达2米。上海中心大厦的工作人员透露，迄今为止，该阻尼器摆动幅度还没有到达过极限状态。", "channel_id": "UCpbfXQsYBJTwq5lCkwGIeuQ", "channel_url": "https://www.youtube.com/channel/UCpbfXQsYBJTwq5lCkwGIeuQ", "duration": 67, "view_count": 5605, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=hIpe86Ha5T0", "categories": ["News & Politics"], "tags": [], "playable_in_embed": true, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "automatic_captions": {}, "subtitles": {}, "comment_count": 1, "like_count": 16, "channel": "中国新闻社", "channel_follower_count": 377000, "license": "Creative Commons Attribution license (reuse allowed)", "uploader": "中国新闻社", "uploader_id": "@cnsvideo", "uploader_url": "https://www.youtube.com/@cnsvideo", "upload_date": "20190810", "timestamp": 1565427896, "availability": "public", "webpage_url_basename": "watch", "webpage_url_domain": "youtube.com", "extractor": "youtube", "extractor_key": "Youtube", "display_id": "hIpe86Ha5T0", "fulltitle": "无惧“利奇马” 中国第一高楼抗台风666", "duration_string": "1:07", "is_live": false, "was_live": false, "epoch": 1794253847, "format": "137 - 1920x1080 (1080p)+14